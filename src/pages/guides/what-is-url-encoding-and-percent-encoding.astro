import Base from '../../layouts/Base.astro';
const title = "What Is Web Address Text Encoding? A Plain Guide - Toolkit Lab";
const description = "What URL encoding does, why spaces become %20, which characters need encoding, and when to use encodeURI or encodeURIComponent.";
---
<Base title={title} description={description} path="/guides/what-is-url-encoding-and-percent-encoding">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap article">
    <p class="note"><a href="/guides">Guides</a> / Web basics</p>
    <h1>What Is Web Address Text Encoding? A Plain Guide</h1>
    <p class="lead">Web addresses can only contain certain characters. When text has spaces or symbols in it, it is changed into a safe form. This guide explains what that change means and why it is needed.</p>
    <div class="ad-slot" aria-label="Advertisement"></div>
<h2>Why web addresses need care</h2>
<p>A web address can only use certain characters, such as letters, numbers and a few symbols. Some symbols have a special job in an address. The ampersand (&amp;), for example, separates parts of the address. If you want to use one as ordinary text, it must be changed.</p>
<h2>How the change works</h2>
<p>Each unsafe character is replaced by a percent sign and a short code. A space becomes %20, and an ampersand becomes %26. The website turns the codes back into the original characters.</p>
<h2>Where you will see it</h2>
<p>You will often see these codes in long web addresses after a search, or in links that carry a name or a message.</p>
<h2>Try it yourself</h2>
<p>Type a sentence into the converter to see the safe version, then convert it back to check.</p>
      <section class="worked">
        <h2>Worked example</h2>
        <p>The text 'a b&amp;c' has a space and an ampersand in it. Written safely for a web address, it becomes a%20b%26c. The %20 stands for a space, and %26 stands for the ampersand.</p>
      </section>
      <section class="faq-list">
        <h2>Frequently asked questions</h2>
        <details><summary>Why does a space sometimes show as a plus sign?</summary><p>Some web forms use a plus sign for a space. Both mean a space in an address, depending on the website.</p></details>
        <details><summary>Which version should I use?</summary><p>Use the whole-address version for a complete link. Use the single-part version for one word or value that goes inside a link.</p></details>
        <details><summary>Why do I see strange codes like %2520?</summary><p>The text was made safe twice, so each code turned into another code. Make the change only once.</p></details>
      </section>
