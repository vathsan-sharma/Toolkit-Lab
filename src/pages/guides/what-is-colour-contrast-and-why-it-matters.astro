import Base from '../../layouts/Base.astro';
const title = "What Is Text Readability? WCAG Ratios Explained - Toolkit Lab";
const description = "What colour contrast ratio means, the WCAG 4.5:1 and 7:1 guidelines for text, and how to check text colours before publishing a website.";
---
<Base title={title} description={description} path="/guides/what-is-colour-contrast-and-why-it-matters.html">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap article">
    <p class="note"><a href="/guides.html">Guides</a> / Accessibility</p>
    <h1>What Is Text Readability? WCAG Ratios Explained</h1>
    <p class="lead">Contrast is the difference in brightness between text and its background. Low contrast makes text hard to read for many people, including those with low vision, and on bright screens.</p>
    <div class="ad-slot" aria-label="Advertisement"></div>
<h2>The ratio</h2>
<p>Contrast is written as a ratio from 1:1 (no difference) to 21:1 (black on white). The ratio is calculated from the brightness of each colour, so it measures what the eye sees rather than how far apart two colour codes are.</p>
<h2>The WCAG guidelines</h2>
<ul>
<li>Normal text should reach 4.5:1 for the AA level, and 7:1 for AAA.</li>
<li>Large text, such as 18 pt or 14 pt bold, needs 3:1 for AA.</li>
</ul>
<h2>Common mistakes</h2>
<p>Light grey text on a white background is a frequent failure, even when it looks clean. Placeholder text in form fields and text on photos are also often too faint.</p>
<h2>Check before you publish</h2>
<p>Test every text and background pair you use, including hover and button states. Changing a single colour can fix several pages at once if your site uses shared styles.</p>
<h2>Try it yourself</h2>
<p>The <a href="/tools/color-contrast-checker.html">Text Readability Checker</a> shows the ratio and whether it passes each level.</p>
      <section class="worked">
        <h2>Worked example</h2>
        <p>Grey text #767676 on white has a contrast ratio of about 4.5:1, which just meets the AA level for normal text. Lighter greys such as #999999 on white fall to about 2.8:1, which fails.</p>
      </section>
      <section class="faq-list">
        <h2>Frequently asked questions</h2>
        <details><summary>Does contrast apply to decorative text?</summary><p>Text that is purely decorative, or part of a logo, is exempt from the guidelines. Text people need to read is not.</p></details>
        <details><summary>What counts as large text?</summary><p>Text at 18 point or larger, or 14 point bold or larger. It needs 3:1 for AA instead of 4.5:1.</p></details>
        <details><summary>Do I need to check dark mode too?</summary><p>Yes. Each colour pair in dark mode has its own ratio, so check both themes.</p></details>
      </section>
