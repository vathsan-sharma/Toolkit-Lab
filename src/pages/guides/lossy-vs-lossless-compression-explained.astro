import Base from '../../layouts/Base.astro';
const title = "Lossy vs Lossless Compression: What Changes in Your Images - Toolkit Lab";
const description = "The difference between lossy and lossless image compression, which formats use each, and how to choose a quality setting without visible damage.";
---
<Base title={title} description={description} path="/guides/lossy-vs-lossless-compression-explained">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap article">
    <p class="note"><a href="/guides">Guides</a> / Image compression</p>
    <h1>Lossy vs Lossless Compression: What Changes in Your Images</h1>
    <p class="lead">Some ways of making picture files smaller remove detail you may not notice. Others keep every detail but leave the file larger. This guide explains the two approaches in plain words.</p>
    <div class="ad-slot" aria-label="Advertisement"></div>
<h2>Two ways to make a picture smaller</h2>
<p>One way throws away some detail that the eye is unlikely to notice, and the picture becomes much smaller. The other way keeps every detail, so the picture is only a little smaller.</p>
<h2>Which to choose</h2>
<ul>
<li><strong>For photos:</strong> the first way works well. A setting of about 75 to 85 usually looks fine.</li>
<li><strong>For screenshots, logos and text:</strong> the second way keeps edges sharp.</li>
</ul>
<h2>A warning</h2>
<p>Each time you save a photo the first way, it loses a little more detail. Keep your original picture and make a smaller copy from it.</p>
      <section class="worked">
        <h2>Worked example</h2>
        <p>A sunset photo saved as a JPG at a quality setting of 80 looks almost the same as the original and is much smaller. The same photo saved as a PNG keeps every detail, and the file is usually several times bigger.</p>
      </section>
      <section class="faq-list">
        <h2>Frequently asked questions</h2>
        <details><summary>What setting should I use for photos?</summary><p>Try 75 to 85. Below about 60, you may start to see blurry or blocky patches.</p></details>
        <details><summary>Is there a format that is both small and perfect?</summary><p>WebP can be saved either way. Use its perfect mode for logos and its small mode for photos.</p></details>
        <details><summary>Why does a picture get worse each time I save it?</summary><p>Each save throws away a little more detail. Keep your original and make copies from it.</p></details>
      </section>
