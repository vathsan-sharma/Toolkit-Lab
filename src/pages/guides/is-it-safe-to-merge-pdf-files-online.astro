import Base from '../../layouts/Base.astro';
const title = "Is It Safe to Merge PDF Files Online? - Toolkit Lab";
const description = "Whether online PDF merge tools upload your files, what to check before using one, and how to merge PDFs without sending them anywhere.";
---
<Base title={title} description={description} path="/guides/is-it-safe-to-merge-pdf-files-online">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap article">
    <p class="note"><a href="/guides">Guides</a> / PDF privacy</p>
    <h1>Is It Safe to Merge PDF Files Online?</h1>
    <p class="lead">Many online PDF tools send your files to a server to combine them. That can be fine for a public brochure, but it is worth checking before you upload a contract, a payslip or an ID document.</p>
    <div class="ad-slot" aria-label="Advertisement"></div>
<h2>How most online merge tools work</h2>
<p>Most websites that merge PDFs upload the files to their servers, combine them there, and let you download the result. Some delete the files after a short time, and others keep them longer. The details are usually in their privacy policy.</p>
<h2>What to check before you upload</h2>
<ul>
<li>Does the site say whether files are uploaded, and where they are stored?</li>
<li>How long are files kept, and can you delete them yourself?</li>
<li>Is the site secured with HTTPS, and does it name the company behind it?</li>
</ul>
<h2>How Toolkit Lab works</h2>
<p>The <a href="/tools/merge-pdf">Merge PDF</a> tool loads a small library into your browser and combines the pages on your device. Your files are not sent to our servers. You can check this yourself: open your browser's developer tools, switch to the network tab, merge a file, and see that no upload request is made.</p>
<h2>Sensitive documents</h2>
<p>For highly confidential documents, a desktop PDF app or the built-in tools on your computer keep the files entirely local. Whatever tool you use, check that you can access the merged file and delete the originals when you are finished.</p>
      <section class="worked">
        <h2>Worked example</h2>
        <p>Suppose you merge a 2-page contract with a 1-page ID scan. A tool that uploads them sends all three pages to its servers. A tool that works in the browser combines the pages on your computer, and the network activity panel in your browser shows no upload.</p>
      </section>
      <section class="faq-list">
        <h2>Frequently asked questions</h2>
        <details><summary>How can I check whether a tool uploads my file?</summary><p>Open your browser's developer tools, go to the Network tab, and merge a file. If no request carries your file to another server, the work happens on your device.</p></details>
        <details><summary>Is it safe to use free online tools for sensitive documents?</summary><p>For confidential documents, use a desktop app or a tool that clearly works locally, and delete the originals when you are done.</p></details>
        <details><summary>What should a privacy policy say about files?</summary><p>It should state whether files are stored, for how long, and whether they are shared with anyone.</p></details>
      </section>
