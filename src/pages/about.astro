---
import Base from '../layouts/Base.astro';
const title = "About Toolkit Lab: Free Online Tools for Everyday Tasks";
const description = "Learn about Toolkit Lab, a free website with browser-based tools for PDFs, images, calculators and everyday text tasks. Your files stay on your device.";
---
<Base title={title} description={description} path="/about.html">
<div class="wrap">
      <h1>About Toolkit Lab</h1>
      <p>Toolkit Lab provides small, free tools that run entirely in your web browser. We built them so everyday tasks like shrinking an image or formatting JSON do not require installing software or creating an account.</p>

      <h2>How it works</h2>
      <p>Each tool processes your input locally in your browser. We do not upload your files or text to our servers.</p>

      <h2>How we pay for it</h2>
      <p>The site is supported by advertising, served through Google AdSense. Ads help cover hosting and development costs. For details on what data advertising partners may collect, see our <a href="privacy.html">Privacy Policy</a>.</p>

      <h2>Contact</h2>
      <p>Questions or suggestions? Visit our <a href="contact.html">contact page</a>.</p>
    </div>

</Base>
