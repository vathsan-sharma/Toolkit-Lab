---
import Base from '../layouts/Base.astro';
const title = "Contact - Toolkit Lab";
const description = "Contact Toolkit Lab.";
---
<Base title={title} description={description} path="/contact.html">
<div class="wrap">
      <h1>Contact</h1>
      <p>Found a bug or have an idea for a new tool? Email us at <strong>your-email@example.com</strong> (replace this with your real address before launch).</p>
    </div>

</Base>
