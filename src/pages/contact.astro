---
import Base from '../layouts/Base.astro';
const title = "Contact Toolkit Lab: Questions and Feedback";
const description = "Contact Toolkit Lab with questions, bug reports or ideas for new free tools. We read every message and reply when we can.";
---
<Base title={title} description={description} path="/contact">
<div class="wrap">
      <h1>Contact</h1>
      <p>Found a bug or have an idea for a new tool? Email us at <strong>your-email@example.com</strong> (replace this with your real address before launch).</p>
    </div>

</Base>
