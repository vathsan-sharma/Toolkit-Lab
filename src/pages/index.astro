---
import Base from '../layouts/Base.astro';
const title = "Toolkit Lab - Free Online Tools for PDFs, Images, Calculators and Text";
const description = "Free browser-based tools: merge and split PDFs, compress images, convert video to MP3, calculate loans and percentages, format JSON and more. Your files never leave your device.";
---
<Base title={title} description={description} path="/">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap">

    <!-- Hero -->
    <section class="hero-grid">
      <div>
        <span class="pill">58 free tools &middot; No sign-up</span>
        <h1>Free tools that work right in your browser</h1>
        <p class="lead">Merge PDFs, compress images, run the numbers and tidy up text. Your files stay on your device, so nothing is uploaded.</p>
        <div class="cta-row">
          <a class="btn" href="#tools">Browse all tools</a>
          <a class="btn btn-ghost" href="/tools/merge-pdf.html">Merge a PDF</a>
        </div>
        <div class="search-field">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="filter" type="search" placeholder="Search tools and guides" aria-label="Search tools and guides" autocomplete="off">
        </div>
        <p class="note">0 files uploaded by our tools. Everything runs on your device.</p>
      </div>

      <div class="preview" aria-hidden="true">
        <div class="preview-head"><span></span><span></span><span></span><b>Merge PDF</b></div>
        <div class="preview-row"><i>1</i><span>report-q1.pdf</span><em>3 pages</em></div>
        <div class="preview-row"><i>2</i><span>invoice.pdf</span><em>1 page</em></div>
        <div class="preview-row"><i>3</i><span>appendix.pdf</span><em>6 pages</em></div>
        <div class="preview-btn">Merge and download</div>
      </div>
    </section>

    <!-- Formats strip (in place of partner logos) -->
    <section class="formats" aria-label="Supported file types">
      <p>Works with</p>
      <ul>
        <li>PDF</li><li>JPG</li><li>PNG</li><li>WebP</li><li>PSD</li><li>MP4</li><li>MP3</li><li>JSON</li>
      </ul>
    </section>

    <!-- Highlighted tools -->
    <section class="block">
      <h2 class="block-title">Our most-used tools</h2>
      <div class="feature-grid">
        <a class="feature" href="/tools/merge-pdf.html">
          <h3>Merge PDF</h3>
          <p>Combine several PDF files into one, in the order you choose. Reorder, remove and download in a few clicks.</p>
          <span class="link">Open tool &rarr;</span>
        </a>
        <a class="feature" href="/tools/image-compressor.html">
          <h3>Image Compressor</h3>
          <p>Shrink JPEG, PNG and WebP files and convert between formats.</p>
          <span class="link">Open tool &rarr;</span>
        </a>
        <a class="feature" href="/tools/loan-calculator.html">
          <h3>Loan Payment Calculator</h3>
          <p>See the monthly payment and total interest on any loan.</p>
          <span class="link">Open tool &rarr;</span>
        </a>
      </div>
    </section>

    <!-- Why choose us -->
    <section class="block">
      <h2 class="block-title">Why people choose Toolkit Lab</h2>
      <div class="why-grid">
        <div><span class="why-icon">&#128274;</span><h3>Private by design</h3><p>Files are processed in your browser and never uploaded to us.</p></div>
        <div><span class="why-icon">&#127873;</span><h3>Free, no sign-up</h3><p>Use every tool without creating an account or paying.</p></div>
        <div><span class="why-icon">&#9889;</span><h3>Fast to start</h3><p>Open a tool and start working. Nothing to install.</p></div>
        <div><span class="why-icon">&#128241;</span><h3>Works on any device</h3><p>Use the same tools on a laptop, tablet or phone.</p></div>
      </div>
    </section>

    <!-- How it works -->
    <section class="block">
      <h2 class="block-title">How it works</h2>
      <ol class="steps">
        <li><span>1</span><h3>Pick a tool</h3><p>Choose from PDF, image, text, calculator and developer tools.</p></li>
        <li><span>2</span><h3>Add your file or numbers</h3><p>Choose a file from your device, or type your values.</p></li>
        <li><span>3</span><h3>Download the result</h3><p>Save the output straight to your device.</p></li>
      </ol>
    </section>

    <!-- All tools, grouped (filterable) -->
    <section id="tools" class="block" data-filter-group>
      <h2 class="block-title">All tools</h2>
      <div class="cat-head"><h3>PDF tools</h3><a href="/pdf-tools.html">5 tools &rarr; see all</a></div>
      <div class="grid">
        <a class="card" data-searchable href="/tools/merge-pdf.html" data-reveal><span class="card-icon">PDF</span><h3>Merge PDF</h3><p>Combine several PDF files into one, in the order you choose.</p></a>
        <a class="card" data-searchable href="/tools/split-pdf.html" data-reveal><span class="card-icon">PDF</span><h3>Split PDF</h3><p>Pull selected pages out of a PDF into a new file.</p></a>
        <a class="card" data-searchable href="/tools/rotate-pdf.html" data-reveal><span class="card-icon">PDF</span><h3>Rotate PDF</h3><p>Turn every page of a PDF by 90, 180 or 270 degrees.</p></a>
        <a class="card" data-searchable href="/tools/image-to-pdf.html" data-reveal><span class="card-icon">IMG</span><h3>JPG and PNG to PDF</h3><p>Put photos or scans into one PDF, one image per page.</p></a>
        <a class="card" data-searchable href="/tools/pdf-to-jpg.html" data-reveal><span class="card-icon">JPG</span><h3>PDF to JPG</h3><p>Save each page of a PDF as a JPG image.</p></a>
      </div>
    </section>

    <section data-filter-group>
      <div class="cat-head"><h3>Images and media</h3><a href="/image-tools.html">6 tools &rarr; see all</a></div>
      <div class="grid">
        <a class="card" data-searchable href="/tools/image-compressor.html" data-reveal><span class="card-icon">IMG</span><h3>Image Compressor</h3><p>Shrink JPEG, PNG and WebP files and convert between formats.</p></a>
        <a class="card" data-searchable href="/tools/psd-converter.html" data-reveal><span class="card-icon">PSD</span><h3>PSD to PNG / JPG</h3><p>Convert Photoshop files to PNG or JPG. Your file stays on your device.</p></a>
                <a class="card" data-searchable href="/tools/image-resizer.html" data-reveal><span class="card-icon">RSZ</span><h3>Image Resizer</h3><p>Resize photos by pixels, keep the aspect ratio, or aim for a target file size in KB.</p></a>
        <a class="card" data-searchable href="/tools/image-converter.html" data-reveal><span class="card-icon">WEBP</span><h3>Image Converter</h3><p>Convert between JPG, PNG and WebP, with quality control and transparency kept.</p></a>
                <a class="card" data-searchable href="/tools/image-to-base64.html" data-reveal><span class="card-icon">B64</span><h3>Image to Code Converter</h3><p>Turn a small image into a data URI for HTML or CSS. Nothing is uploaded.</p></a>
                <a class="card" data-searchable href="/tools/video-to-mp3.html" data-reveal><span class="card-icon">MP3</span><h3>Video to MP3</h3><p>Extract the audio from a video you own and save it as MP3.</p></a>
      </div>
    </section>

    <section data-filter-group>
      <div class="cat-head"><h3>Calculators</h3><a href="/calculators.html">21 tools &rarr; see all</a></div>
      <div class="grid">
        <a class="card" data-searchable href="/tools/loan-calculator.html" data-reveal><span class="card-icon">EMI</span><h3>Loan Payment Calculator</h3><p>See the monthly payment and total interest on a loan.</p></a>
                <a class="card" data-searchable href="/tools/compound-interest-calculator.html" data-reveal><span class="card-icon">CI</span><h3>Compound Interest Calculator</h3><p>See how savings grow over time with interest added, and how much is interest.</p></a>
                <a class="card" data-searchable href="/tools/tip-calculator.html" data-reveal><span class="card-icon">TIP</span><h3>Tip Calculator</h3><p>Work out the tip, the total and each person's share of a bill.</p></a>
                <a class="card" data-searchable href="/tools/sip-calculator.html" data-reveal><span class="card-icon">SIP</span><h3>Monthly Investment Calculator</h3><p>See how a fixed monthly investment could grow at an assumed yearly return.</p></a>
        <a class="card" data-searchable href="/tools/sales-tax-vat-calculator.html" data-reveal><span class="card-icon">TAX</span><h3>Sales Tax and VAT Calculator</h3><p>Work out sales tax or VAT on a price, or the price before tax from a total.</p></a>
                <a class="card" data-searchable href="/tools/fraction-calculator.html" data-reveal><span class="card-icon">1/2</span><h3>Fraction Calculator</h3><p>Add, subtract, multiply or divide fractions and get the answer in lowest terms.</p></a>
        <a class="card" data-searchable href="/tools/speed-distance-time-calculator.html" data-reveal><span class="card-icon">MPH</span><h3>Speed, Distance and Time</h3><p>Fill in any two values and the third is worked out for you.</p></a>
        <a class="card" data-searchable href="/tools/salary-to-hourly-converter.html" data-reveal><span class="card-icon">PAY</span><h3>Salary to Hourly Pay</h3><p>Turn an annual salary into hourly, weekly and monthly pay.</p></a>
                <a class="card" data-searchable href="/tools/time-duration-calculator.html" data-reveal><span class="card-icon">TIME</span><h3>Time Duration Calculator</h3><p>Work out hours and minutes between two times, including overnight shifts.</p></a>
                <a class="card" data-searchable href="/tools/simple-interest-calculator.html" data-reveal><span class="card-icon">SI</span><h3>Simple Interest Calculator</h3><p>Work out simple interest and the total on a loan or deposit.</p></a>
                <a class="card" data-searchable href="/tools/running-pace-calculator.html" data-reveal><span class="card-icon">PACE</span><h3>Running Pace Calculator</h3><p>Work out your pace per kilometre or mile and your average speed.</p></a>
                <a class="card" data-searchable href="/tools/mean-median-mode-calculator.html" data-reveal><span class="card-icon">AVG</span><h3>Mean, Median and Mode</h3><p>Work out the average, middle value, most common value and range of a list.</p></a>
                <a class="card" data-searchable href="/tools/fuel-economy-converter.html" data-reveal><span class="card-icon">MPG</span><h3>Fuel Economy Converter</h3><p>Convert fuel economy between US mpg, UK mpg and litres per 100 km.</p></a>
                <a class="card" data-searchable href="/tools/data-size-converter.html" data-reveal><span class="card-icon">DATA</span><h3>File Size Converter</h3><p>Convert sizes between bits, bytes, KB, MB, GB and TB.</p></a>
                <a class="card" data-searchable href="/tools/download-time-calculator.html" data-reveal><span class="card-icon">DL</span><h3>Download Time Calculator</h3><p>Estimate how long a file takes to download at your connection speed.</p></a>
        <a class="card" data-searchable href="/tools/bmi-calculator.html" data-reveal><span class="card-icon">BMI</span><h3>BMI Calculator</h3><p>Work out your Body Mass Index in metric or imperial units.</p></a>
        <a class="card" data-searchable href="/tools/percentage-calculator.html" data-reveal><span class="card-icon">%</span><h3>Percentage Calculator</h3><p>Find percentages, what share a number is, and percentage change.</p></a>
        <a class="card" data-searchable href="/tools/date-calculator.html" data-reveal><span class="card-icon">DAY</span><h3>Date Calculator</h3><p>Count the days between two dates, or add and subtract days.</p></a>
        <a class="card" data-searchable href="/tools/age-calculator.html" data-reveal><span class="card-icon">AGE</span><h3>Age Calculator</h3><p>Work out your exact age in years, months and days, and days to your next birthday.</p></a>
                <a class="card" data-searchable href="/tools/discount-calculator.html" data-reveal><span class="card-icon">%</span><h3>Discount Calculator</h3><p>Work out the sale price, the saving and the total with sales tax.</p></a>
        <a class="card" data-searchable href="/tools/unit-converter.html" data-reveal><span class="card-icon">kg</span><h3>Unit Converter</h3><p>Convert length, weight and temperature between metric and imperial units.</p></a>
      </div>
    </section>

    <section data-filter-group>
      <div class="cat-head"><h3>Text and developer tools</h3><a href="/text-and-developer-tools.html">26 tools &rarr; see all</a></div>
      <div class="grid">
                <a class="card" data-searchable href="/tools/text-diff-checker.html" data-reveal><span class="card-icon">DIFF</span><h3>Text Diff Checker</h3><p>Compare two texts and see which lines were added, removed or unchanged.</p></a>
        <a class="card" data-searchable href="/tools/word-counter.html" data-reveal><span class="card-icon">Aa</span><h3>Word Counter</h3><p>Words, characters, sentences and estimated reading time, live.</p></a>
        <a class="card" data-searchable href="/tools/case-converter.html" data-reveal><span class="card-icon">Tt</span><h3>Case Converter</h3><p>Switch text to UPPERCASE, Title Case, camelCase, snake_case and more.</p></a>
        <a class="card" data-searchable href="/tools/json-formatter.html" data-reveal><span class="card-icon">&#123; &#125;</span><h3>Data File Formatter</h3><p>Beautify, minify and validate JSON with clear error messages.</p></a>
        <a class="card" data-searchable href="/tools/base64.html" data-reveal><span class="card-icon">64</span><h3>Text to Code Converter (Base64)</h3><p>Encode text to Base64 and decode it back, with full UTF-8 support.</p></a>
        <a class="card" data-searchable href="/tools/lorem-ipsum-generator.html" data-reveal><span class="card-icon">Lo</span><h3>Placeholder Text Generator</h3><p>Placeholder text in paragraphs, sentences or words for mockups.</p></a>
        <a class="card" data-searchable href="/tools/hash-generator.html" data-reveal><span class="card-icon">#A</span><h3>File Fingerprint Generator</h3><p>Calculate SHA-256, SHA-512 and other hashes for text or files.</p></a>
        <a class="card" data-searchable href="/tools/password-generator.html" data-reveal><span class="card-icon">***</span><h3>Password Generator</h3><p>Create strong random passwords. Generated on your device, never stored.</p></a>
        <a class="card" data-searchable href="/tools/qr-code-generator.html" data-reveal><span class="card-icon">QR</span><h3>QR Code Generator</h3><p>Turn a link or text into a QR code and download it as a PNG.</p></a>
        <a class="card" data-searchable href="/tools/color-converter.html" data-reveal><span class="card-icon">#</span><h3>Colour Code Converter</h3><p>Switch between HEX, RGB and HSL with a live color preview.</p></a>
                <a class="card" data-searchable href="/tools/random-number-generator.html" data-reveal><span class="card-icon">RNG</span><h3>Random Number Generator</h3><p>Pick random numbers in any range, with or without repeats.</p></a>
        <a class="card" data-searchable href="/tools/url-encoder.html" data-reveal><span class="card-icon">URL</span><h3>Web Address Text Converter</h3><p>Percent-encode text for web addresses, or decode it back.</p></a>
                <a class="card" data-searchable href="/tools/unix-timestamp-converter.html" data-reveal><span class="card-icon">UNIX</span><h3>Computer Date Converter</h3><p>Convert epoch seconds to a date, or a date to a timestamp.</p></a>
        <a class="card" data-searchable href="/tools/url-slug-generator.html" data-reveal><span class="card-icon">/a</span><h3>Web Page Name Maker</h3><p>Turn a title into a clean lowercase slug for a web address.</p></a>
                <a class="card" data-searchable href="/tools/roman-numeral-converter.html" data-reveal><span class="card-icon">XIV</span><h3>Roman Numeral Converter</h3><p>Convert numbers 1 to 3999 to Roman numerals, and back.</p></a>
        <a class="card" data-searchable href="/tools/regex-tester.html" data-reveal><span class="card-icon">.*</span><h3>Text Pattern Tester</h3><p>Test a regular expression on sample text and see each match highlighted.</p></a>
        <a class="card" data-searchable href="/tools/typing-speed-test.html" data-reveal><span class="card-icon">WPM</span><h3>Typing Speed Test</h3><p>Measure your words per minute and accuracy in a short passage.</p></a>
                <a class="card" data-searchable href="/tools/csv-to-json.html" data-reveal><span class="card-icon">CSV</span><h3>Spreadsheet to Data File Converter</h3><p>Turn spreadsheet CSV text, with a header row, into JSON objects.</p></a>
        <a class="card" data-searchable href="/tools/markdown-preview.html" data-reveal><span class="card-icon">MD</span><h3>Simple Text Formatting Preview</h3><p>Write Markdown and see headings, lists and links formatted as you type.</p></a>
        <a class="card" data-searchable href="/tools/password-strength-checker.html" data-reveal><span class="card-icon">PW</span><h3>Password Strength Checker</h3><p>Estimate how strong a password is. It is checked in your browser and never sent.</p></a>
                <a class="card" data-searchable href="/tools/number-base-converter.html" data-reveal><span class="card-icon">BIN</span><h3>Number System Converter</h3><p>Convert numbers between binary, decimal, hexadecimal and octal.</p></a>
                <a class="card" data-searchable href="/tools/remove-duplicate-lines.html" data-reveal><span class="card-icon">DUP</span><h3>Remove Duplicate Lines</h3><p>Remove repeated lines from a list, ignoring case and spaces, and sort it.</p></a>
                <a class="card" data-searchable href="/tools/dice-roller.html" data-reveal><span class="card-icon">DICE</span><h3>Dice Roller</h3><p>Roll up to twenty dice with 4 to 100 sides, using secure random numbers.</p></a>
                <a class="card" data-searchable href="/tools/text-to-speech.html" data-reveal><span class="card-icon">TTS</span><h3>Text to Speech</h3><p>Have your browser read pasted text aloud, with voice, speed and pitch options.</p></a>
                <a class="card" data-searchable href="/tools/color-contrast-checker.html" data-reveal><span class="card-icon">AA</span><h3>Text Readability Checker</h3><p>Check text and background colours against WCAG contrast guidelines.</p></a>
        <a class="card" data-searchable href="/tools/stopwatch.html" data-reveal><span class="card-icon">00</span><h3>Online Stopwatch</h3><p>Start, pause and record laps. Space and L keys work too.</p></a>
      </div>
    </section>

    <p id="filter-empty" class="empty-state" hidden>No tools or guides match that search. Try &ldquo;image&rdquo; or &ldquo;password&rdquo;.</p>

    <div class="ad-slot" aria-label="Advertisement"></div>

    <!-- FAQ -->
    <section class="block faq-block">
      <div>
        <h2 class="block-title">Questions, answered</h2>
        <p class="lead">Quick answers about how Toolkit Lab works. More detail is in our <a href="/guides.html">guides</a>.</p>
      </div>
      <div class="faq">
        <details><summary>Are my files uploaded anywhere?</summary><p>No. The tools run in your browser, so your files and text stay on your device. The only data our pages load comes from public libraries such as PDF and image engines.</p></details>
        <details><summary>Do I need an account?</summary><p>No. You can use every tool without signing up.</p></details>
        <details><summary>Is it free?</summary><p>Yes. All tools are free to use.</p></details>
        <details><summary>Why does Video to MP3 take a while the first time?</summary><p>The converter engine is large, about 30 MB. It downloads the first time you convert, then conversions are faster.</p></details>
        <details><summary>Does it work on a phone?</summary><p>Yes. Every page is designed to work on phones, tablets and desktops.</p></details>
      </div>
    </section>

    <!-- Closing call to action -->
    <section class="cta-band">
      <div>
        <h2>Ready when you are</h2>
        <p>Pick a tool and get your result in seconds.</p>
      </div>
      <div class="cta-row">
        <a class="btn" href="#tools">Browse all tools</a>
        <a class="btn btn-ghost" href="/guides.html">Read the guides</a>
      </div>
    </section>

  </div>
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
</Base>
