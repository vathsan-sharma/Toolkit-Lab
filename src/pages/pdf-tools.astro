---
import Base from '../layouts/Base.astro';
const title = "Free Online PDF Tools: Merge, Split, Rotate and Convert - Toolkit Lab";
const description = "Free online PDF tools: merge PDFs, split pages, rotate pages, turn images into PDF and PDF pages into JPG. Files stay on your device.";
---
<Base title={title} description={description} path="/pdf-tools.html">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap">
    <div class="tool-head">
      <p class="crumbs"><a href="/index.html">Home</a> / PDF Tools</p>
      <h1>Free PDF tools that run in your browser</h1>
      <p class="lead">PDF tools handle the everyday jobs: combining several documents into one, pulling out the pages you need, fixing a sideways scan, or turning photos into a single file. These tools do the work in your browser, so a contract or ID document is never sent to a server.</p>
    </div>
    <div class="ad-slot" aria-label="Advertisement"></div>
    <section class="block">
      <div class="grid">
        <a class="card" href="/tools/merge-pdf.html"><span class="card-icon">MER</span><h3>Merge PDF</h3><p>Combine several PDF files into one, in the order you choose.</p></a>
        <a class="card" href="/tools/split-pdf.html"><span class="card-icon">SPL</span><h3>Split PDF</h3><p>Pull selected pages out of a PDF into a new file.</p></a>
        <a class="card" href="/tools/rotate-pdf.html"><span class="card-icon">ROT</span><h3>Rotate PDF</h3><p>Turn every page of a PDF by 90, 180 or 270 degrees.</p></a>
        <a class="card" href="/tools/image-to-pdf.html"><span class="card-icon">JPG</span><h3>JPG and PNG to PDF</h3><p>Put photos or scans into one PDF, one image per page.</p></a>
        <a class="card" href="/tools/pdf-to-jpg.html"><span class="card-icon">PDF</span><h3>PDF to JPG</h3><p>Save each page of a PDF as a JPG image.</p></a>
      </div>
    </section>
    <section class="block faq-block" style="grid-template-columns:1fr">
      <h2 class="block-title" style="text-align:left">Questions</h2>
      <div class="faq">
        <details><summary>Are my PDFs uploaded?</summary><p>No. The tools read and write the file in your browser.</p></details>
        <details><summary>Is there a page limit?</summary><p>The limit is your device memory. Very large files may be slow.</p></details>
      </div>
    </section>
    <div class="ad-slot" aria-label="Advertisement"></div>
  </div>
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
</Base>
