---
import Base from '../../layouts/Base.astro';
const title = "GST Calculator: Add or Remove GST - Toolkit Lab";
const description = "Work out the GST on an amount, with GST added to a price or removed from a GST-inclusive price. Choose the rate and see the split.";
---
<Base title={title} description={description} path="/tools/gst-calculator.html">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap">
    <div class="tool-head">
      <p class="crumbs"><a href="/index.html">Tools</a> / GST Calculator</p>
      <h1>GST Calculator</h1>
      <p class="lead">Add GST to a price, or find the price and GST inside a total that already includes it.</p>
      <p class="how-to"><strong>How to use:</strong> Enter an amount and the GST rate, and choose whether the amount is before or including GST.</p>
    </div>

    <div class="ad-slot" aria-label="Advertisement"></div>

<div class="panel">
      <div class="grid" style="grid-template-columns:1fr 1fr 1fr;gap:14px">
        <div><label for="amount">Amount</label><input type="number" id="amount" min="0" step="0.01" value="1000"></div>
        <div><label for="rate">GST rate (%)</label><input type="number" id="rate" min="0" step="0.5" value="18"></div>
        <div><label for="mode">Amount is</label>
          <select id="mode"><option value="exclusive" selected>Before GST (add GST)</option><option value="inclusive">Including GST (remove GST)</option></select>
        </div>
      </div>
      <p id="error" class="error" hidden></p>
      <div class="stats">
        <div class="stat"><strong id="net">-</strong><span>Price before GST</span></div>
        <div class="stat"><strong id="tax">-</strong><span>GST amount</span></div>
        <div class="stat"><strong id="gross">-</strong><span>Price including GST</span></div>
      </div>
      <p class="note">Check the current rate for each item in your country. Rates can differ between goods and services.</p>
    </div>

    <div class="ad-slot" aria-label="Advertisement"></div>
  </div>
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>

  <script is:inline>
(function () {
  var money = function (n) { return n.toLocaleString(undefined, { style: 'currency', currency: 'USD' }); };
  function update() {
    var amount = parseFloat(document.getElementById('amount').value);
    var rate = parseFloat(document.getElementById('rate').value);
    var mode = document.getElementById('mode').value;
    var errorEl = document.getElementById('error');
    if (!(amount >= 0) || !(rate >= 0)) { errorEl.textContent = 'Enter an amount and a rate of zero or more.'; errorEl.hidden = false; return; }
    errorEl.hidden = true;
    var net, gst, gross;
    if (mode === 'exclusive') { net = amount; gst = amount * rate / 100; gross = net + gst; }
    else { gross = amount; net = amount / (1 + rate / 100); gst = gross - net; }
    document.getElementById('net').textContent = money(net);
    document.getElementById('tax').textContent = money(gst);
    document.getElementById('gross').textContent = money(gross);
  }
  document.querySelectorAll('input, select').forEach(function (el) { el.addEventListener('input', update); el.addEventListener('change', update); });
  update();
})();
  </script>
</Base>
