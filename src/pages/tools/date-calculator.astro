---
import Base from '../../layouts/Base.astro';
const title = "Date Calculator: Days Between Dates - Toolkit Lab";
const description = "Count the days between two dates, or add and subtract days from a date. Free and private.";
---
<Base title={title} description={description} path="/tools/date-calculator.html">
<aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
    <div class="wrap">
      <div class="tool-head">
        <p class="crumbs"><a href="../index.html">Tools</a> / Date Calculator</p>
        <h1>Date Calculator</h1>
        <p class="lead">Count the days between two dates, or find the date that is a set number of days from another.</p>
      <p class="how-to"><strong>How to use:</strong> Pick a start and end date to see the days between them, or a start date and a number of days to find the result date.</p>
      <p class="learn-more">Want more detail? <a href="/guides/how-to-count-days-between-two-dates.html">How to Count Days Between Two Dates</a></p>
      </div>

      <!-- AdSense: place your ad unit code here once your site is approved. -->
      <div class="ad-slot" aria-label="Advertisement"></div>

      <div class="panel">
        <h2 style="margin-top:0">Days between two dates</h2>
        <div class="grid" style="grid-template-columns:1fr 1fr;gap:14px">
          <div>
            <label for="startDate">Start date</label>
            <input type="date" id="startDate">
          </div>
          <div>
            <label for="endDate">End date</label>
            <input type="date" id="endDate">
          </div>
        </div>
        <div class="stats" id="diffStats" hidden>
          <div class="stat"><strong id="diffDays">-</strong><span>Days</span></div>
          <div class="stat"><strong id="diffWeeks">-</strong><span>Weeks and days</span></div>
          <div class="stat"><strong id="diffMonths">-</strong><span>Approx. months</span></div>
        </div>
        <p id="diffError" class="error" hidden></p>

        <h2>Add or subtract days</h2>
        <div class="grid" style="grid-template-columns:1fr 1fr;gap:14px">
          <div>
            <label for="baseDate">Starting date</label>
            <input type="date" id="baseDate">
          </div>
          <div>
            <label for="offset">Number of days (negative to subtract)</label>
            <input type="number" id="offset" value="30" step="1">
          </div>
        </div>
        <div class="stats" id="shiftStats" hidden>
          <div class="stat"><strong id="shiftResult">-</strong><span>Result</span></div>
          <div class="stat"><strong id="shiftWeekday">-</strong><span>Day of the week</span></div>
        </div>
        <p id="shiftError" class="error" hidden></p>
      </div>

      <!-- AdSense: place your ad unit code here once your site is approved. -->
      <div class="ad-slot" aria-label="Advertisement"></div>
    </div>
    <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
<script is:inline>
    const DAY = 24 * 60 * 60 * 1000;
    // Parse yyyy-mm-dd as a local date to avoid timezone shifts.
    function parseDate(value) {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
      return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null;
    }

    function formatDate(d) {
      return d.toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    }

    function updateDiff() {
      const start = parseDate(document.getElementById('startDate').value);
      const end = parseDate(document.getElementById('endDate').value);
      const stats = document.getElementById('diffStats');
      const err = document.getElementById('diffError');
      if (!start || !end) { stats.hidden = true; err.hidden = true; return; }

      const days = Math.round((end - start) / DAY);
      err.hidden = true;
      stats.hidden = false;
      document.getElementById('diffDays').textContent = Math.abs(days).toLocaleString();
      const weeks = Math.floor(Math.abs(days) / 7);
      document.getElementById('diffWeeks').textContent = weeks + 'w ' + (Math.abs(days) % 7) + 'd';
      document.getElementById('diffMonths').textContent = (Math.abs(days) / 30.44).toFixed(1);
      if (days < 0) {
        err.textContent = 'End date is before start date. Showing the absolute difference.';
        err.hidden = false;
      }
    }

    function updateShift() {
      const base = parseDate(document.getElementById('baseDate').value);
      const offset = parseInt(document.getElementById('offset').value, 10);
      const stats = document.getElementById('shiftStats');
      const err = document.getElementById('shiftError');
      if (!base || !isFinite(offset)) { stats.hidden = true; err.hidden = true; return; }

      const result = new Date(base.getFullYear(), base.getMonth(), base.getDate() + offset);
      err.hidden = true;
      stats.hidden = false;
      document.getElementById('shiftResult').textContent = result.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
      document.getElementById('shiftWeekday').textContent = result.toLocaleDateString(undefined, { weekday: 'long' });
    }

    ['startDate', 'endDate'].forEach(id => document.getElementById(id).addEventListener('input', updateDiff));
    ['baseDate', 'offset'].forEach(id => document.getElementById(id).addEventListener('input', updateShift));

    const today = new Date();
    const iso = d => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    document.getElementById('startDate').value = iso(today);
    document.getElementById('baseDate').value = iso(today);
    const later = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 90);
    document.getElementById('endDate').value = iso(later);
    updateDiff();
    updateShift();
  </script>
</Base>
