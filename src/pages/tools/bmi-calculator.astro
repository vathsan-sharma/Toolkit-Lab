---
import Base from '../../layouts/Base.astro';
const title = "BMI Calculator - Toolkit Lab";
const description = "Calculate your Body Mass Index (BMI) from height and weight in metric or imperial units. Private and free.";
---
<Base title={title} description={description} path="/tools/bmi-calculator.html">
<aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
    <div class="wrap">
      <h1>BMI Calculator</h1>
      <p class="lead">Body Mass Index is a rough screening measure. It does not account for muscle, age or body composition.</p>
      <p class="how-to"><strong>How to use:</strong> Choose metric or imperial units, enter your height and weight, and the BMI and category update as you type.</p>
      <div class="ad-slot" aria-label="Advertisement"></div>

      <div class="panel">
        <label for="units">Units</label>
        <select id="units" style="max-width:260px">
          <option value="metric" selected>Metric (cm, kg)</option>
          <option value="imperial">Imperial (ft/in, lb)</option>
        </select>

        <div id="metricFields">
          <label for="heightCm">Height (cm)</label>
          <input type="number" id="heightCm" min="50" max="260" step="0.1" value="170">

          <label for="weightKg">Weight (kg)</label>
          <input type="number" id="weightKg" min="10" max="400" step="0.1" value="70">
        </div>

        <div id="imperialFields" hidden>
          <label for="heightFt">Height (feet)</label>
          <input type="number" id="heightFt" min="1" max="8" step="1" value="5">

          <label for="heightIn">Height (inches)</label>
          <input type="number" id="heightIn" min="0" max="11" step="0.5" value="7">

          <label for="weightLb">Weight (lb)</label>
          <input type="number" id="weightLb" min="20" max="880" step="0.5" value="154">
        </div>

        <div class="row">
          <button id="calculate">Calculate BMI</button>
        </div>

        <p id="error" class="error" hidden></p>

        <div class="stats" id="results" hidden>
          <div class="stat"><strong id="bmi">-</strong><span>Your BMI</span></div>
          <div class="stat"><strong id="category">-</strong><span>Category</span></div>
          <div class="stat"><strong id="range">-</strong><span>Healthy weight for your height</span></div>
        </div>
      </div>

      <!-- AdSense: place your ad unit code here once your site is approved. -->
      <div class="ad-slot" aria-label="Advertisement"></div>
    </div>
    <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
<script is:inline>
    const unitsEl = document.getElementById('units');
    const errorEl = document.getElementById('error');
    const resultsEl = document.getElementById('results');

    function num(id) {
      return parseFloat(document.getElementById(id).value);
    }

    unitsEl.addEventListener('change', () => {
      const imperial = unitsEl.value === 'imperial';
      document.getElementById('metricFields').hidden = imperial;
      document.getElementById('imperialFields').hidden = !imperial;
      resultsEl.hidden = true;
      errorEl.hidden = true;
    });

    function heightAndWeight() {
      if (unitsEl.value === 'imperial') {
        const inches = num('heightFt') * 12 + num('heightIn');
        return { heightM: inches * 0.0254, weightKg: num('weightLb') * 0.45359237 };
      }
      return { heightM: num('heightCm') / 100, weightKg: num('weightKg') };
    }

    function category(bmi) {
      if (bmi < 18.5) return 'Underweight';
      if (bmi < 25) return 'Healthy weight';
      if (bmi < 30) return 'Overweight';
      return 'Obesity';
    }

    const calculate = () => {
      const { heightM, weightKg } = heightAndWeight();
      if (!(heightM > 0) || !(weightKg > 0) || !isFinite(heightM) || !isFinite(weightKg)) {
        errorEl.textContent = 'Please enter a valid height and weight.';
        errorEl.hidden = false;
        resultsEl.hidden = true;
        return;
      }
      errorEl.hidden = true;

      const bmi = weightKg / (heightM * heightM);
      const lowKg = 18.5 * heightM * heightM;
      const highKg = 24.9 * heightM * heightM;

      document.getElementById('bmi').textContent = bmi.toFixed(1);
      document.getElementById('category').textContent = category(bmi);
      document.getElementById('range').textContent =
        Math.round(lowKg) + ' to ' + Math.round(highKg) + ' kg';
      resultsEl.hidden = false;
    };
    // Update as the person types, and keep the button working as a fallback.
    document.querySelectorAll('input, select').forEach(el => el.addEventListener('input', calculate));
    document.getElementById('calculate').addEventListener('click', calculate);
    calculate();
  </script>
</Base>
