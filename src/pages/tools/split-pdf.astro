---
import Base from '../../layouts/Base.astro';
const title = "Split PDF: Extract Pages Online - Toolkit Lab";
const description = "Pull out selected pages from a PDF into a new file, such as pages 2 to 5 or 1, 3 and 7. Runs in your browser.";
---
<Base title={title} description={description} path="/tools/split-pdf.html">
  <Fragment slot="head">
    <script is:inline src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js" defer></script>
  </Fragment>
<aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
    <div class="wrap">
      <div class="tool-head">
        <p class="crumbs"><a href="../index.html">Tools</a> / Split PDF</p>
        <h1>Split PDF</h1>
        <p class="lead">Choose the pages you need from a PDF and save them as a new file.</p>
      <p class="how-to"><strong>How to use:</strong> Choose a PDF, enter the page numbers to keep (for example 1-3, 5), and press Extract and download.</p>
      </div>

      <!-- AdSense: place your ad unit code here once your site is approved. -->
      <div class="ad-slot" aria-label="Advertisement"></div>

      <div class="panel">
        <label for="file">PDF file</label>
        <input type="file" id="file" accept="application/pdf,.pdf">
        <p id="info" class="note" hidden></p>

        <label for="range">Pages to keep</label>
        <input type="text" id="range" placeholder="for example 1-3, 5, 8-10" spellcheck="false">
        <p class="note">Separate ranges with commas. Page numbers start at 1.</p>

        <div class="row">
          <button id="split" type="button" disabled>Extract and download</button>
        </div>

        <p id="error" class="error" hidden></p>
      </div>

      <!-- AdSense: place your ad unit code here once your site is approved. -->
      <div class="ad-slot" aria-label="Advertisement"></div>
    </div>
    <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
<script is:inline>
    const fileInput = document.getElementById('file');
    const rangeInput = document.getElementById('range');
    const splitBtn = document.getElementById('split');
    const errorEl = document.getElementById('error');
    const info = document.getElementById('info');
    let file = null;
    let pageCount = 0;

    function showError(message) {
      errorEl.textContent = message;
      errorEl.hidden = !message;
    }

    // Turns "1-3, 5" into zero-based page indexes, or null if the text is invalid.
    function parseRanges(text, total) {
      const indexes = new Set();
      for (const part of text.split(',').map(p => p.trim()).filter(Boolean)) {
        const m = /^(\d+)(?:\s*-\s*(\d+))?$/.exec(part);
        if (!m) return null;
        const from = parseInt(m[1], 10);
        const to = m[2] ? parseInt(m[2], 10) : from;
        if (from < 1 || to > total || from > to) return null;
        for (let p = from; p <= to; p++) indexes.add(p - 1);
      }
      return indexes.size ? [...indexes].sort((a, b) => a - b) : null;
    }

    fileInput.addEventListener('change', async () => {
      showError('');
      file = fileInput.files[0] || null;
      splitBtn.disabled = true;
      info.hidden = true;
      if (!file) return;
      if (!window.PDFLib) {
        showError('The PDF library could not load. Check your internet connection and try again.');
        return;
      }
      try {
        const doc = await window.PDFLib.PDFDocument.load(await file.arrayBuffer());
        pageCount = doc.getPageCount();
        info.textContent = file.name + ' has ' + pageCount + ' page' + (pageCount === 1 ? '' : 's') + '.';
        info.hidden = false;
        splitBtn.disabled = false;
      } catch (err) {
        showError('This PDF could not be read. It may be password-protected or damaged.');
      }
    });

    splitBtn.addEventListener('click', async () => {
      showError('');
      const indexes = parseRanges(rangeInput.value, pageCount);
      if (!indexes) {
        showError('Enter page numbers between 1 and ' + pageCount + ', for example 1-3, 5.');
        return;
      }
      splitBtn.disabled = true;
      try {
        const { PDFDocument } = window.PDFLib;
        const source = await PDFDocument.load(await file.arrayBuffer());
        const out = await PDFDocument.create();
        const pages = await out.copyPages(source, indexes);
        pages.forEach(page => out.addPage(page));
        const bytes = await out.save();
        const url = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = file.name.replace(/\.pdf$/i, '') + '-pages.pdf';
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 10000);
      } catch (err) {
        showError('Could not create the new PDF. Please try again.');
      } finally {
        splitBtn.disabled = false;
      }
    });
  </script>
</Base>
