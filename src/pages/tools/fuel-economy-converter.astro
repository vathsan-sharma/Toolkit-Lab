---
import Base from '../../layouts/Base.astro';
const title = "Fuel Economy Converter: MPG to L/100km and Back - Toolkit Lab";
const description = "Convert fuel economy between miles per gallon (US and UK) and litres per 100 kilometres. Free, private and runs in your browser.";
---
<Base title={title} description={description} path="/tools/fuel-economy-converter.html">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap">
    <div class="tool-head">
      <p class="crumbs"><a href="/index.html">Tools</a> / Fuel Economy Converter</p>
      <h1>Fuel Economy Converter</h1>
      <p class="lead">Enter a fuel economy figure in any unit to see it in the others. Lower L/100km means a more efficient car.</p>
      <p class="how-to"><strong>How to use:</strong> Type a figure into US mpg, UK mpg or litres per 100 km. The other two update automatically.</p>
    </div>
    <div class="ad-slot" aria-label="Advertisement"></div>
<div class="panel">
      <div class="grid" style="grid-template-columns:1fr 1fr 1fr;gap:14px">
        <div><label for="us">US mpg</label><input type="number" id="us" min="0" step="0.1" value="30"></div>
        <div><label for="uk">UK mpg</label><input type="number" id="uk" min="0" step="0.1"></div>
        <div><label for="l">Litres per 100 km</label><input type="number" id="l" min="0" step="0.1"></div>
      </div>
      <p id="error" class="error" hidden></p>
      <p class="note">US gallons are 3.785 litres, and UK gallons are 4.546 litres. A UK mpg figure is higher than a US one for the same car.</p>
    </div>
    <div class="ad-slot" aria-label="Advertisement"></div>
  </div>
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <script is:inline>
(function () {
  var US_FACTOR = 235.215, UK_FACTOR = 282.481;
  var ids = ['us', 'uk', 'l'];
  var errorEl = document.getElementById('error');
  var busy = false;
  function show(id, value) { document.getElementById(id).value = isFinite(value) ? Number(value.toFixed(2)) : ''; }
  ids.forEach(function (source) {
    document.getElementById(source).addEventListener('input', function () {
      if (busy) return;
      var v = parseFloat(document.getElementById(source).value);
      busy = true;
      if (document.getElementById(source).value === '') { ids.forEach(function (id) { if (id !== source) document.getElementById(id).value = ''; }); busy = false; errorEl.hidden = true; return; }
      if (!(v > 0)) { errorEl.textContent = 'Enter a number above zero.'; errorEl.hidden = false; busy = false; return; }
      errorEl.hidden = true;
      var litres = source === 'us' ? US_FACTOR / v : source === 'uk' ? UK_FACTOR / v : v;
      if (source !== 'us') show('us', US_FACTOR / litres);
      if (source !== 'uk') show('uk', UK_FACTOR / litres);
      if (source !== 'l') show('l', litres);
      busy = false;
    });
  });
  document.getElementById('us').dispatchEvent(new Event('input'));
})();
  </script>
</Base>
