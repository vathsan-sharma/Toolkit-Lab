---
import Base from '../../layouts/Base.astro';
const title = "Discount Calculator: Sale Price, Savings and Tax - Toolkit Lab";
const description = "Work out the sale price, the amount you save and the total with tax from a price and a discount percentage. Free, private and runs in your browser.";
---
<Base title={title} description={description} path="/tools/discount-calculator.html">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap">
    <div class="tool-head">
      <p class="crumbs"><a href="/index.html">Tools</a> / Discount Calculator</p>
      <h1>Discount Calculator</h1>
      <p class="lead">Enter the original price and the discount. Add a sales tax rate if you want the final total with tax.</p>
      <p class="how-to"><strong>How to use:</strong> Enter the price, the discount percentage and an optional tax rate. The sale price, saving and total update as you type.</p>
    </div>

    <div class="ad-slot" aria-label="Advertisement"></div>

    <div class="panel">
      <div class="grid" style="grid-template-columns:1fr 1fr 1fr;gap:14px">
        <div>
          <label for="price">Original price</label>
          <input type="number" id="price" min="0" step="0.01" value="80">
        </div>
        <div>
          <label for="discount">Discount (%)</label>
          <input type="number" id="discount" min="0" max="100" step="0.1" value="25">
        </div>
        <div>
          <label for="tax">Sales tax (%, optional)</label>
          <input type="number" id="tax" min="0" step="0.1" value="0">
        </div>
      </div>

      <p id="error" class="error" hidden></p>
      <div class="stats" id="stats">
        <div class="stat"><strong id="sale">-</strong><span>Sale price</span></div>
        <div class="stat"><strong id="saved">-</strong><span>You save</span></div>
        <div class="stat"><strong id="total">-</strong><span>Total with tax</span></div>
      </div>
      <p class="note">The tax is added after the discount is taken off. Check your local rules for how tax applies.</p>
    </div>

    <div class="ad-slot" aria-label="Advertisement"></div>
  </div>
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>

  <script is:inline>
    (function () {
      var money = function (n) { return n.toLocaleString(undefined, { style: 'currency', currency: 'USD' }); };
      function update() {
        var price = parseFloat(document.getElementById('price').value);
        var discount = parseFloat(document.getElementById('discount').value);
        var tax = parseFloat(document.getElementById('tax').value);
        var errorEl = document.getElementById('error');
        if (!(price >= 0) || !(discount >= 0 && discount <= 100) || !(tax >= 0 || isNaN(tax))) {
          errorEl.textContent = 'Enter a price of zero or more, and a discount between 0 and 100.';
          errorEl.hidden = false;
          return;
        }
        errorEl.hidden = true;
        var taxRate = isNaN(tax) ? 0 : tax;
        var saved = price * discount / 100;
        var sale = price - saved;
        var total = sale * (1 + taxRate / 100);
        document.getElementById('sale').textContent = money(sale);
        document.getElementById('saved').textContent = money(saved);
        document.getElementById('total').textContent = money(total);
      }
      document.querySelectorAll('input').forEach(function (el) { el.addEventListener('input', update); });
      update();
    })();
  </script>
</Base>
