---
import Base from '../../layouts/Base.astro';
const title = "Computer Date Converter: Turn Numbers into Dates - Toolkit Lab";
const description = "Convert a Unix timestamp in seconds to a readable UTC date, or convert a date to its Unix timestamp. Free and private.";
---
<Base title={title} description={description} path="/tools/unix-timestamp-converter.html">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap">
    <div class="tool-head">
      <p class="crumbs"><a href="/index.html">Tools</a> / Computer Date Converter</p>
      <h1>Computer Date Converter</h1>
      <p class="lead">Turn a computer date number into a normal date, or a date into a computer number. Times are shown in world time (UTC).</p>
      <p class="how-to"><strong>How to use:</strong> Enter a Unix timestamp in seconds, or pick a date and time. The other format updates, and Use current time fills in now.</p>
    </div>

    <div class="ad-slot" aria-label="Advertisement"></div>

<div class="panel">
      <label for="ts">Computer date number (seconds since 1 January 1970, world time)</label>
      <input type="number" id="ts" step="1" value="1793004000">
      <div class="row"><button id="now" type="button" class="secondary">Use current time</button></div>
      <label for="dt">Date and time (world time)</label>
      <input type="datetime-local" id="dt">
      <p id="error" class="error" hidden></p>
      <div class="stats">
        <div class="stat"><strong id="iso">-</strong><span>Standard format (world time)</span></div>
        <div class="stat"><strong id="human">-</strong><span>Written out (world time)</span></div>
        <div class="stat"><strong id="back">-</strong><span>Computer date number for this date</span></div>
      </div>
    </div>

    <div class="ad-slot" aria-label="Advertisement"></div>
  </div>
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>

  <script is:inline>
(function () {
  var tsEl = document.getElementById('ts');
  var dtEl = document.getElementById('dt');
  var errorEl = document.getElementById('error');
  function showFromTs() {
    var s = parseFloat(tsEl.value);
    if (!isFinite(s)) { errorEl.textContent = 'Enter a number of seconds.'; errorEl.hidden = false; return; }
    var d = new Date(s * 1000);
    if (isNaN(d.getTime())) { errorEl.textContent = 'That timestamp is outside the range of dates.'; errorEl.hidden = false; return; }
    errorEl.hidden = true;
    document.getElementById('iso').textContent = d.toISOString();
    document.getElementById('human').textContent = d.toUTCString();
    dtEl.value = d.toISOString().slice(0, 16);
    document.getElementById('back').textContent = Math.floor(d.getTime() / 1000);
  }
  function showFromDate() {
    if (!dtEl.value) return;
    var ms = Date.parse(dtEl.value + 'Z');
    if (isNaN(ms)) { errorEl.textContent = 'Enter a valid date and time.'; errorEl.hidden = false; return; }
    errorEl.hidden = true;
    tsEl.value = Math.floor(ms / 1000);
    document.getElementById('back').textContent = Math.floor(ms / 1000);
    var d = new Date(ms);
    document.getElementById('iso').textContent = d.toISOString();
    document.getElementById('human').textContent = d.toUTCString();
  }
  tsEl.addEventListener('input', showFromTs);
  dtEl.addEventListener('input', showFromDate);
  document.getElementById('now').addEventListener('click', function () {
    tsEl.value = Math.floor(Date.now() / 1000);
    showFromTs();
  });
  showFromTs();
})();
  </script>
</Base>
