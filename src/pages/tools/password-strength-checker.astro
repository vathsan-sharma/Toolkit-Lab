---
import Base from '../../layouts/Base.astro';
const title = "Password Strength Checker: How Strong Is Your Password? - Toolkit Lab";
const description = "Check how strong a password is, based on length and character variety. Your password is checked in your browser and never sent anywhere.";
---
<Base title={title} description={description} path="/tools/password-strength-checker.html">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap">
    <div class="tool-head">
      <p class="crumbs"><a href="/index.html">Tools</a> / Password Strength Checker</p>
      <h1>Password Strength Checker</h1>
      <p class="lead">Type a password to see a strength estimate. The check runs on your device and the password is not stored or sent.</p>
      <p class="how-to"><strong>How to use:</strong> Type a password to see its rating and tips. The password is checked on your device and is not stored.</p>
    </div>

    <div class="ad-slot" aria-label="Advertisement"></div>

<div class="panel">
      <label for="pw">Password</label>
      <input type="password" id="pw" autocomplete="off" spellcheck="false" placeholder="Type a password to test">
      <label><input type="checkbox" id="show"> Show password</label>
      <div style="margin-top:16px"><div style="height:10px;border-radius:999px;background:var(--surface-2);overflow:hidden"><div id="bar" style="height:100%;width:0;background:var(--accent);transition:width 0.2s"></div></div></div>
      <div class="stats">
        <div class="stat"><strong id="rating">-</strong><span>Rating</span></div>
        <div class="stat"><strong id="length">0</strong><span>Characters</span></div>
        <div class="stat"><strong id="bits">0</strong><span>Estimated bits of entropy</span></div>
      </div>
      <ul id="tips" class="note" style="padding-left:18px"></ul>
      <p class="note">This is an estimate based on length and character types. It cannot detect common words or leaked passwords, so use a password manager and unique passwords.</p>
    </div>

    <div class="ad-slot" aria-label="Advertisement"></div>
  </div>
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>

  <script is:inline>
(function () {
  var pw = document.getElementById('pw');
  var bar = document.getElementById('bar');
  var tips = document.getElementById('tips');
  document.getElementById('show').addEventListener('change', function (e) { pw.type = e.target.checked ? 'text' : 'password'; });
  function update() {
    var v = pw.value, pool = 0;
    if (/[a-z]/.test(v)) pool += 26;
    if (/[A-Z]/.test(v)) pool += 26;
    if (/[0-9]/.test(v)) pool += 10;
    if (/[^a-zA-Z0-9]/.test(v)) pool += 32;
    var bits = pool && v.length ? Math.round(v.length * Math.log2(pool)) : 0;
    var rating = !v ? '-' : bits < 40 ? 'Weak' : bits < 60 ? 'Fair' : bits < 80 ? 'Good' : 'Strong';
    var pct = Math.min(100, bits / 100 * 100);
    bar.style.width = pct + '%';
    bar.style.background = bits < 40 ? '#b42318' : bits < 60 ? '#b45309' : 'var(--accent)';
    document.getElementById('rating').textContent = rating;
    document.getElementById('length').textContent = v.length;
    document.getElementById('bits').textContent = bits;
    tips.innerHTML = '';
    if (v) {
      if (v.length < 12) addTip('Use at least 12 characters. Length matters most.');
      if (!/[A-Z]/.test(v) || !/[a-z]/.test(v)) addTip('Mix uppercase and lowercase letters.');
      if (!/[0-9]/.test(v)) addTip('Add numbers.');
      if (!/[^a-zA-Z0-9]/.test(v)) addTip('Add symbols if the site allows them.');
      if (/^(.)\1+$/.test(v)) addTip('Avoid repeating one character.');
    }
  }
  function addTip(text) { var li = document.createElement('li'); li.textContent = text; tips.appendChild(li); }
  pw.addEventListener('input', update);
  update();
})();
  </script>
</Base>
