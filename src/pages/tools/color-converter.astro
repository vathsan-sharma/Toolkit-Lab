---
import Base from '../../layouts/Base.astro';
const title = "Colour Code Converter: HEX, RGB and HSL - Toolkit Lab";
const description = "Convert colors between HEX, RGB and HSL with a live preview and one-click copy. Free and private.";
---
<Base title={title} description={description} path="/tools/color-converter.html">
<aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
    <div class="wrap">
      <div class="tool-head">
        <p class="crumbs"><a href="../index.html">Tools</a> / Colour Code Converter</p>
        <h1>Colour Code Converter</h1>
        <p class="lead">Pick a colour or type its code in any style. The other codes update as you type.</p>
      <p class="how-to"><strong>How to use:</strong> Pick a colour with the picker or type a HEX, RGB or HSL value. The other two formats update as you type.</p>
      </div>

      <!-- AdSense: place your ad unit code here once your site is approved. -->
      <div class="ad-slot" aria-label="Advertisement"></div>

      <div class="panel">
        <div class="row" style="margin-top:0">
          <input type="color" id="picker" value="#5b5bd6" aria-label="Pick a color" style="width:72px;height:56px;padding:4px;border-radius:12px;border:1px solid var(--border-strong);background:var(--bg);cursor:pointer">
          <div id="swatch" style="flex:1;min-width:200px;height:56px;border-radius:14px;border:1px solid var(--border);background:#5b5bd6"></div>
        </div>

        <label for="hex">colour code</label>
        <div class="row" style="margin-top:6px">
          <input type="text" id="hex" value="#5B5BD6" spellcheck="false" style="flex:1;font-family:ui-monospace,Menlo,Consolas,monospace">
          <button class="secondary" data-copy-target="hex" type="button">Copy</button>
        </div>

        <label for="rgb">red-green-blue</label>
        <div class="row" style="margin-top:6px">
          <input type="text" id="rgb" spellcheck="false" style="flex:1;font-family:ui-monospace,Menlo,Consolas,monospace">
          <button class="secondary" data-copy-target="rgb" type="button">Copy</button>
        </div>

        <label for="hsl">hue-saturation</label>
        <div class="row" style="margin-top:6px">
          <input type="text" id="hsl" spellcheck="false" style="flex:1;font-family:ui-monospace,Menlo,Consolas,monospace">
          <button class="secondary" data-copy-target="hsl" type="button">Copy</button>
        </div>

        <p id="error" class="error" hidden></p>
      </div>

      <!-- AdSense: place your ad unit code here once your site is approved. -->
      <div class="ad-slot" aria-label="Advertisement"></div>
    </div>
    <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
<script is:inline>
    const picker = document.getElementById('picker');
    const swatch = document.getElementById('swatch');
    const hexEl = document.getElementById('hex');
    const rgbEl = document.getElementById('rgb');
    const hslEl = document.getElementById('hsl');
    const errorEl = document.getElementById('error');

    function clamp(n, min, max) { return Math.min(max, Math.max(min, n)); }

    function parseHex(text) {
      const m = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(text.trim());
      if (!m) return null;
      let h = m[1];
      if (h.length === 3) h = h.split('').map(c => c + c).join('');
      return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
    }

    function parseRgb(text) {
      const m = /^rgb?\(?\s*(\d{1,3})\s*[, ]\s*(\d{1,3})\s*[, ]\s*(\d{1,3})\s*\)?$/i.exec(text.trim());
      if (!m) return null;
      return [m[1], m[2], m[3]].map(n => clamp(+n, 0, 255));
    }

    function parseHsl(text) {
      const m = /^hsl\(?\s*(\d{1,3})\s*[, ]\s*(\d{1,3})%?\s*[, ]\s*(\d{1,3})%?\s*\)?$/i.exec(text.trim());
      if (!m) return null;
      return hslToRgb(clamp(+m[1], 0, 360), clamp(+m[2], 0, 100), clamp(+m[3], 0, 100));
    }

    function rgbToHex(r, g, b) {
      return '#' + [r, g, b].map(n => Math.round(n).toString(16).padStart(2, '0')).join('').toUpperCase();
    }

    function rgbToHsl(r, g, b) {
      r /= 255; g /= 255; b /= 255;
      const max = Math.max(r, g, b), min = Math.min(r, g, b);
      let h = 0, s = 0;
      const l = (max + min) / 2;
      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        if (max === r) h = (g - b) / d + (g < b ? 6 : 0);
        else if (max === g) h = (b - r) / d + 2;
        else h = (r - g) / d + 4;
        h *= 60;
      }
      return [Math.round(h), Math.round(s * 100), Math.round(l * 100)];
    }

    function hslToRgb(h, s, l) {
      s /= 100; l /= 100;
      const k = n => (n + h / 30) % 12;
      const a = s * Math.min(l, 1 - l);
      const f = n => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
      return [f(0), f(8), f(4)].map(v => Math.round(v * 255));
    }

    function paint(rgb) {
      const [r, g, b] = rgb;
      const hex = rgbToHex(r, g, b);
      const [h, s, l] = rgbToHsl(r, g, b);
      swatch.style.background = hex;
      picker.value = hex.toLowerCase();
      hexEl.value = hex;
      rgbEl.value = 'rgb(' + r + ', ' + g + ', ' + b + ')';
      hslEl.value = 'hsl(' + h + ', ' + s + '%, ' + l + '%)';
    }

    function fromInput(source, rgb) {
      errorEl.hidden = true;
      if (!rgb) {
        errorEl.textContent = 'That value is not a valid color in ' + source.toUpperCase() + ' format.';
        errorEl.hidden = false;
        return;
      }
      const [r, g, b] = rgb;
      const hex = rgbToHex(r, g, b);
      const [h, s, l] = rgbToHsl(r, g, b);
      swatch.style.background = hex;
      picker.value = hex.toLowerCase();
      if (source !== 'hex') hexEl.value = hex;
      if (source !== 'rgb') rgbEl.value = 'rgb(' + r + ', ' + g + ', ' + b + ')';
      if (source !== 'hsl') hslEl.value = 'hsl(' + h + ', ' + s + '%, ' + l + '%)';
    }

    picker.addEventListener('input', () => paint(parseHex(picker.value)));
    hexEl.addEventListener('input', () => fromInput('hex', parseHex(hexEl.value)));
    rgbEl.addEventListener('input', () => fromInput('rgb', parseRgb(rgbEl.value)));
    hslEl.addEventListener('input', () => fromInput('hsl', parseHsl(hslEl.value)));

    document.querySelectorAll('[data-copy-target]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const input = document.getElementById(btn.dataset.copyTarget);
        try {
          await navigator.clipboard.writeText(input.value);
        } catch (err) {
          input.select();
          document.execCommand('copy');
        }
      });
    });

    paint(parseHex('#5B5BD6'));
  </script>
</Base>
