---
import Base from '../../layouts/Base.astro';
const title = "Tip Calculator: Tip Amount and Split the Bill - Toolkit Lab";
const description = "Work out the tip, the total and each person's share of a bill. Choose the tip percentage and number of people. Free and private.";
---
<Base title={title} description={description} path="/tools/tip-calculator.html">
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>
  <div class="wrap">
    <div class="tool-head">
      <p class="crumbs"><a href="/index.html">Tools</a> / Tip Calculator</p>
      <h1>Tip Calculator</h1>
      <p class="lead">Enter the bill, pick a tip, and split it between the people paying.</p>
      <p class="how-to"><strong>How to use:</strong> Enter the bill, the tip percentage and the number of people. The tip, total and each share update.</p>
    </div>

    <div class="ad-slot" aria-label="Advertisement"></div>

<div class="panel">
      <div class="grid" style="grid-template-columns:1fr 1fr 1fr;gap:14px">
        <div><label for="bill">Bill before tip</label><input type="number" id="bill" min="0" step="0.01" value="60"></div>
        <div><label for="tip">Tip (%)</label><input type="number" id="tip" min="0" max="100" step="0.5" value="18"></div>
        <div><label for="people">People sharing</label><input type="number" id="people" min="1" step="1" value="3"></div>
      </div>
      <p id="error" class="error" hidden></p>
      <div class="stats">
        <div class="stat"><strong id="tipAmt">-</strong><span>Tip</span></div>
        <div class="stat"><strong id="total">-</strong><span>Total</span></div>
        <div class="stat"><strong id="each">-</strong><span>Each person pays</span></div>
      </div>
    </div>

    <div class="ad-slot" aria-label="Advertisement"></div>
  </div>
  <aside class="ad-rail" aria-label="Advertisement"><div class="ad-slot ad-slot-rail"></div></aside>

  <script is:inline>
(function () {
  var money = function (n) { return n.toLocaleString(undefined, { style: 'currency', currency: window.QTH_CURRENCY || 'USD' }); };
  function update() {
    var bill = parseFloat(document.getElementById('bill').value);
    var tip = parseFloat(document.getElementById('tip').value);
    var people = parseInt(document.getElementById('people').value, 10);
    var errorEl = document.getElementById('error');
    if (!(bill >= 0) || !(tip >= 0) || !(people >= 1)) {
      errorEl.textContent = 'Enter a bill of zero or more, a tip of zero or more, and at least one person.';
      errorEl.hidden = false; return;
    }
    errorEl.hidden = true;
    var tipAmount = bill * tip / 100;
    var total = bill + tipAmount;
    document.getElementById('tipAmt').textContent = money(tipAmount);
    document.getElementById('total').textContent = money(total);
    document.getElementById('each').textContent = money(total / people);
  }
  document.querySelectorAll('input').forEach(function (el) { el.addEventListener('input', update); });
  update();
})();
  </script>
</Base>
