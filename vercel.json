{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/guides/index.html",
      "destination": "/guides.html",
      "permanent": true
    },
    {
      "source": "/tools/gst-calculator.html",
      "destination": "/tools/sales-tax-vat-calculator.html",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
